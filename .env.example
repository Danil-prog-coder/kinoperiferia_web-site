# --- Сайт ---
BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Selectel S3 ---
# Endpoint и регион берутся в панели Selectel у самого бакета: у каждого
# бакета свой регион, и ru-1 вместо ru-6 даёт ошибку подписи, а не понятную
# ошибку доступа.
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=
# Сервисные ключи (Selectel -> Identity & Access -> Сервисные пользователи -> S3-ключи):
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Бэкап данных (заявки + вложения) ---
# Раз в 30 минут архив data/ перезаписывает ОДИН объект в S3 (новые не копятся).
# Бакет по умолчанию — S3_BUCKET; можно отдельный:
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=backups/kinoperiferia-data.tar.gz
BACKUP_INTERVAL_MINUTES=30
# Восстановление при старте (сайт начинает принимать запросы только после него):
#   always — каждый раз подтягивать данные из S3 (но не если в бэкапе заявок
#            меньше, чем локально: это значит, что бэкап устарел после падения);
#   empty  — только если локально заявок нет;  off — никогда.
# При остановке/перезапуске сайт сначала снимает финальный бэкап.
BACKUP_RESTORE_ON_START=always
