{{- define "masthead" -}}
<header class="masthead" data-header>
  <div class="masthead__row">
    <a class="logo" href="/">Кино<b>периферия</b></a>
    <nav class="nav" aria-label="Основное меню" data-scroll-spy>
      <a href="/catalog"{{ if eq .Nav "catalog" }} aria-current="page"{{ end }}>Каталог</a>
      <a href="/#custom">На заказ</a>
      <a href="/#about">Производство</a>
      <a href="/#delivery">Доставка</a>
      <a href="/#contacts">Контакты</a>
    </nav>
    <div class="masthead__actions">
      <a class="cart-link" href="/order" aria-label="Корзина заявки">
        Корзина<span class="cart-link__count" data-cart-count hidden>0</span>
      </a>
      <a class="btn btn--solid btn--sm" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Написать в Telegram</a>
      <a class="icon-btn icon-btn--mobile" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer" aria-label="Написать в Telegram">↗</a>
      <button class="burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Открыть меню">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav aria-label="Основное меню">
    <a href="/catalog">Каталог</a>
    <a href="/#custom">На заказ</a>
    <a href="/#about">Производство</a>
    <a href="/#delivery">Доставка</a>
    <a href="/#contacts">Контакты</a>
    <a href="/order">Корзина<span class="cart-link__count" data-cart-count hidden>0</span></a>
  </nav>
  <a class="btn btn--solid" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Написать в Telegram ↗</a>
</div>
{{- end -}}

{{- define "photo-placeholder" -}}
<div class="ph" role="img" aria-label="Фотография изделия «{{ .Name }}» появится позже">
  <span class="ph__mark">КП</span>
  <span class="ph__text">Фото скоро</span>
</div>
{{- end -}}

{{- define "card" -}}
<a class="card" href="/product/{{ .Slug }}" data-quick-view="{{ .Slug }}">
  <div class="card__media">
    {{- if .HasPhoto }}
    <img class="card__img" src="{{ .Image }}" alt="{{ .Alt }}" loading="lazy" decoding="async" width="480" height="600">
    {{- else }}
    {{ template "photo-placeholder" . }}
    {{- end }}
  </div>
  <h3 class="card__name">{{ .Name }}</h3>
  <p class="card__desc">{{ .Desc }}</p>
  <div class="price-row">
    <span class="price">{{ .PriceLabel }}</span>
    {{- with .OldPriceLabel }}<span class="price--old">{{ . }}</span>{{ end }}
  </div>
</a>
{{- end -}}

{{- define "catalog-teaser" -}}
<section id="catalog" class="section">
  <div class="section__head">
    <h2 class="section__title">{{ .Catalog.Heading }}</h2>
    <a class="section__note section__note--link" href="{{ .Catalog.MoreURL }}">{{ .Catalog.TotalLabel }}</a>
  </div>
  <div class="rule-thin" style="margin: var(--space-6) 0"></div>
  <div class="grid grid--catalog">
    {{- range .Catalog.Products }}
    {{ template "card" . }}
    {{- end }}
  </div>
  <div class="catalog-teaser__more">
    <a class="btn btn--ghost" href="{{ .Catalog.MoreURL }}">Показать больше</a>
  </div>
</section>
{{- end -}}

{{- define "catalog-full" -}}
<section id="catalog" class="section">
  <div class="section__head">
    <div>
      <h2 class="section__title">{{ .Catalog.Heading }}</h2>
      <p class="section__note">{{ .Catalog.CountLabel }}</p>
    </div>
  </div>

  <div class="tabs" role="group" aria-label="Фильтр по категориям" data-catalog-tabs>
    {{- range .Catalog.Categories }}
    <a class="tab" href="{{ .URL }}"{{ if .Active }} aria-current="true"{{ end }} data-filter="{{ .Slug }}">{{ .Title }} <span class="tab__count">{{ .Count }}</span></a>
    {{- end }}
  </div>

  <div class="rule-thin" style="margin-top: var(--space-6)"></div>

  <div data-catalog-body>
    {{- if .Catalog.Products }}
    <div class="grid grid--catalog" id="catalog-grid">
      {{- range .Catalog.Products }}
      {{ template "card" . }}
      {{- end }}
    </div>
    {{- else }}
    <p class="empty" id="catalog-grid">В этой категории пока пусто. Загляните в другие разделы или напишите в Telegram — сошьём под задачу.</p>
    {{- end }}
  </div>
</section>
{{- end -}}

{{- define "order-form" -}}
{{- if .Submitted -}}
<div class="notice" data-order-submitted>
  Заявка принята. Свяжемся по указанному контакту — обычно в течение рабочего дня.
  <span class="notice__id">Номер заявки: {{ .OrderID }}</span>
</div>
<div class="hero__actions">
  <a class="btn btn--solid" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Написать в Telegram ↗</a>
  <a class="btn btn--ghost" href="/catalog">Вернуться в каталог</a>
</div>
{{- else -}}
{{- if .Failed -}}
<div class="notice notice--error">
  Заявку не удалось отправить. Проверьте поля ниже или напишите напрямую в <a href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer" style="color:var(--accent)">Telegram</a>.
</div>
{{- end -}}

<form class="form" method="post" action="/order" enctype="multipart/form-data" novalidate data-order-form>
  <div class="field{{ if index .Errors "name" }} field--invalid{{ end }}">
    <label for="name">Как к вам обращаться</label>
    <input id="name" name="name" type="text" maxlength="100" required autocomplete="name" value="{{ .Form.Name }}">
    {{- with index .Errors "name" }}<span class="field__error">{{ . }}</span>{{ end }}
  </div>

  <div class="field{{ if index .Errors "contact" }} field--invalid{{ end }}">
    <label for="contact">Telegram, телефон или почта</label>
    <input id="contact" name="contact" type="text" maxlength="120" required value="{{ .Form.Contact }}">
    {{- with index .Errors "contact" }}<span class="field__error">{{ . }}</span>{{ end }}
  </div>

  <div class="cart" data-cart-list hidden></div>
  <input type="hidden" name="items" data-cart-items-input value="">

  <div class="field" data-product-field>
    <label for="product">Изделие</label>
    <select id="product" name="product">
      <option value="">Кастомное изделие / не выбрано</option>
      {{- $selected := .Form.Product -}}
      {{- range .Products }}
      <option value="{{ .Slug }}"{{ if eq .Slug $selected }} selected{{ end }}>{{ .Art }} · {{ .Name }} — {{ .PriceLabel }}</option>
      {{- end }}
    </select>
    <span class="field__hint">Или добавьте несколько изделий в корзину прямо из каталога.</span>
  </div>

  <div class="field{{ if index .Errors "message" }} field--invalid{{ end }}">
    <label for="message">Что нужно сшить</label>
    <textarea id="message" name="message" maxlength="2000" placeholder="Размеры, оборудование, сроки">{{ .Form.Message }}</textarea>
    {{- with index .Errors "message" }}<span class="field__error">{{ . }}</span>{{ end }}
  </div>

  <div class="field{{ if index .Errors "files" }} field--invalid{{ end }}">
    <label for="files">Фото или файлы (необязательно)</label>
    <input id="files" name="files" type="file" multiple accept="image/*,.pdf">
    <span class="field__hint">До 5 файлов, каждый до 10 МБ.</span>
    {{- with index .Errors "files" }}<span class="field__error">{{ . }}</span>{{ end }}
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required>
    <span>Согласен(на) на <a href="/privacy" target="_blank" style="color:var(--accent)">обработку персональных данных</a></span>
  </label>

  <div class="honey" aria-hidden="true">
    <label for="company">Не заполняйте это поле</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div class="hero__actions" style="margin-top: 0">
    <button class="btn btn--solid" type="submit" data-submit-btn data-idle-text="Отправить заявку" data-busy-text="Отправляем…">Отправить заявку</button>
    <a class="btn btn--ghost" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Написать в Telegram ↗</a>
  </div>
  <p class="form__hint">Отправляя форму, вы соглашаетесь на обработку указанных контактных данных для ответа на заявку.</p>
</form>
{{- end -}}
{{- end -}}

{{- define "contacts" -}}
<section id="contacts" class="section section--flush-top">
  <div class="rule-thin"></div>
  <div class="contacts">
    <h2 class="contacts__title">Не нашли нужное?</h2>
    <div>
      <p class="contacts__text">Опишите задачу в Telegram — подберём готовое изделие из каталога или сошьём <a href="/#custom" style="color:var(--accent)">под ваш сетап</a>.</p>
      <div class="link-list">
        <a href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer"><span>Telegram {{ .Site.TelegramTag }}</span><span>↗</span></a>
        <a href="{{ .Site.PhoneHref }}"><span>{{ .Site.Phone }}</span><span>↗</span></a>
        <a href="{{ .Site.EmailHref }}"><span>{{ .Site.Email }}</span><span>↗</span></a>
      </div>
    </div>
  </div>
</section>
{{- end -}}

{{- define "site-footer" -}}
<footer class="site-footer">
  <div class="site-footer__row">
    <a class="logo logo--footer" href="/">Кино<b>периферия</b></a>
    <nav class="site-footer__nav" aria-label="Меню в подвале">
      <a href="/catalog">Каталог</a>
      <a href="/#custom">На заказ</a>
      <a href="/#delivery">Доставка</a>
      <a href="/privacy">Конфиденциальность</a>
    </nav>
  </div>
  <div class="site-footer__row">
    <div class="link-list link-list--footer">
      <a href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Telegram {{ .Site.TelegramTag }}</a>
      <a href="{{ .Site.PhoneHref }}">{{ .Site.Phone }}</a>
      <a href="{{ .Site.EmailHref }}">{{ .Site.Email }}</a>
    </div>
    <span class="site-footer__legal">{{ .Site.Brand }} © {{ .Year }} · {{ .Site.Requisites }}</span>
  </div>
</footer>
{{- end -}}
