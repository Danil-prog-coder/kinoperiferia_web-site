{{- define "content" -}}
<section id="top" class="hero">
  <div class="hero__copy">
    <p class="hero__eyebrow">{{ .Site.Tagline }}</p>
    <h1 class="hero__title hero__title--xl">Все для СЪЕМОК</h1>
    <div class="hero__actions">
      <a class="btn btn--solid" href="#catalog">Смотреть каталог</a>
      <a class="btn btn--ghost" href="#custom">Сделать на заказ</a>
    </div>
  </div>
  <figure class="hero__figure">
    <div class="frame">
      {{- if .Hero.HasPhoto }}
      <img class="hero__img" src="{{ .Hero.Image }}" alt="{{ .Hero.Alt }}" width="1200" height="1500" fetchpriority="high" decoding="async">
      {{- else }}
      {{ template "photo-placeholder" .Hero }}
      {{- end }}
    </div>
  </figure>
</section>

<section class="pitch">
  <h2 class="pitch__title">Ваш идеальный результат — наша главная цель.</h2>
  <p class="pitch__text">Мы делаем вещи из лучших материалов, чтобы вы пользовались ими долгие годы. Для нас нет мелочей.</p>
  <ul class="pitch__list">
    <li>Даём гарантию 1 год на каждый продукт</li>
    <li>Личный подход и правки на любом этапе</li>
  </ul>
  <p class="pitch__closing">Мы знаем, что делаем!</p>
</section>

{{ template "catalog-teaser" . }}

<section id="custom" class="custom">
  <div class="custom__inner">
    <div>
      <h2 class="custom__title">Нет нужного размера — сошьём под ваш сетап</h2>
      <p class="custom__text">Пришлите фото, размеры и список оборудования. Согласуем конструкцию, материалы и срок напрямую с производством.</p>
      <a class="btn btn--dark" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Обсудить изделие ↗</a>
    </div>
    <ol class="steps">
      {{- range .Site.CustomSteps }}
      <li>
        <span class="steps__num">{{ .Index }}</span>
        <span class="steps__label">{{ .Title }}</span>
        <span class="steps__term">{{ .Term }}</span>
      </li>
      {{- end }}
    </ol>
  </div>
  {{- if .Site.CustomCases }}
  <div class="cases">
    {{- range .Site.CustomCases }}
    <div class="case">
      <div class="ph" role="img" aria-label="Фотография кейса появится позже"><span class="ph__mark">КП</span><span class="ph__text">Фото скоро</span></div>
      <p class="case__text"><span class="case__label">Просили</span> {{ .Request }}</p>
      <p class="case__text"><span class="case__label">Сшили</span> {{ .Result }}</p>
    </div>
    {{- end }}
  </div>
  {{- end }}
</section>

<section id="about" class="section">
  <div class="section__head">
    <h2 class="section__title">Производство</h2>
  </div>
  <div class="production">
    <div class="production__gallery">
      <div class="ph ph--wide" role="img" aria-label="Фотография цеха появится позже"><span class="ph__mark">КП</span><span class="ph__text">Фото цеха скоро</span></div>
      <div class="ph ph--wide" role="img" aria-label="Фотография материалов появится позже"><span class="ph__mark">КП</span><span class="ph__text">Фото материалов скоро</span></div>
    </div>
    <ul class="facts">
      {{- range .Site.Features }}
      <li><span class="facts__title">{{ .Title }}</span><span class="facts__text">{{ .Text }}</span></li>
      {{- end }}
    </ul>
  </div>
</section>

<section id="delivery" class="section section--flush-top">
  <div class="section__head">
    <h2 class="section__title">Доставка</h2>
  </div>
  <table class="delivery-table">
    <thead>
      <tr><th scope="col">Способ</th><th scope="col">Срок</th><th scope="col">Стоимость</th></tr>
    </thead>
    <tbody>
      {{- range .Site.Delivery }}
      <tr><td>{{ .Method }}</td><td>{{ .Term }}</td><td>{{ .Cost }}</td></tr>
      {{- end }}
    </tbody>
  </table>
</section>

<section id="contacts" class="section section--flush-top">
  <div class="rule-thick"></div>
  <div class="section__head">
    <h2 class="section__title">Расскажите, что нужно сшить</h2>
  </div>
  <div class="contact-grid">
    <div>{{ template "order-form" .Contact }}</div>
    <div class="contact-info">
      <div class="link-list">
        <a href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer"><span>Telegram {{ .Site.TelegramTag }}</span><span>↗</span></a>
        <a href="{{ .Site.PhoneHref }}"><span>{{ .Site.Phone }}</span><span>↗</span></a>
        <a href="{{ .Site.EmailHref }}"><span>{{ .Site.Email }}</span><span>↗</span></a>
      </div>
      <p class="contact-info__text">{{ .Site.PickupAddress }}<br>{{ .Site.Hours }}</p>
    </div>
  </div>
</section>
{{- end -}}
