{{- define "content" -}}
{{ template "catalog-full" . }}

<section id="delivery" class="section section--flush-top">
  <div class="section__head">
    <h2 class="section__title">Доставка</h2>
  </div>
  <table class="delivery-table">
    <thead>
      <tr><th scope="col">Способ</th><th scope="col">Срок</th><th scope="col">Стоимость</th></tr>
    </thead>
    <tbody>
      {{- range .Site.Delivery }}
      <tr><td>{{ .Method }}</td><td>{{ .Term }}</td><td>{{ .Cost }}</td></tr>
      {{- end }}
    </tbody>
  </table>
</section>

<section id="contacts" class="section section--flush-top">
  <div class="rule-thick"></div>
  <div class="section__head">
    <h2 class="section__title">Расскажите, что нужно сшить</h2>
  </div>
  <div class="contact-grid">
    <div>{{ template "order-form" .Contact }}</div>
    <div class="contact-info">
      <div class="link-list">
        <a href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer"><span>Telegram {{ .Site.TelegramTag }}</span><span>↗</span></a>
        <a href="{{ .Site.PhoneHref }}"><span>{{ .Site.Phone }}</span><span>↗</span></a>
        <a href="{{ .Site.EmailHref }}"><span>{{ .Site.Email }}</span><span>↗</span></a>
      </div>
      <p class="contact-info__text">{{ .Site.PickupAddress }}<br>{{ .Site.Hours }}</p>
    </div>
  </div>
</section>
{{- end -}}
