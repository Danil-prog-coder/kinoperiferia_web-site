{{- define "content" -}}
<section id="top" class="hero">
  <div class="hero__copy">
    <div class="eyebrow">Выпуск {{ .Year }} · изделие {{ .Hero.Art }}</div>
    <h1 class="hero__title">
      <span class="hero__title-line">Шьем,</span>
      <span class="hero__title-line">чтобы</span>
      <span class="hero__title-line hero__title-line--accent">снимать.</span>
    </h1>
    <p class="lede hero__text">Синесэдлы, сумки, ложементы и текстиль для света. Готовые изделия и производство под конкретный сетап.</p>
    <div class="hero__actions">
      <a class="btn btn--solid" href="#catalog">Смотреть каталог</a>
      <a class="btn btn--ghost" href="#custom">Сделать на заказ</a>
    </div>
  </div>
  <figure class="hero__figure">
    <div class="frame">
      {{- if .Hero.HasPhoto }}
      <img id="hero-img" class="hero__img" src="{{ .Hero.Image }}" alt="{{ .Hero.Alt }}" width="1200" height="900" fetchpriority="high" decoding="async">
      {{- else }}
      {{ template "photo-placeholder" .Hero }}
      {{- end }}
    </div>
    <figcaption class="hero__caption">
      <span>{{ .Hero.Name }} — {{ .Hero.Desc }}</span>
      <span class="hero__price">{{ .Hero.PriceLabel }}</span>
    </figcaption>
  </figure>
</section>

{{ template "ticker" . }}

{{ template "catalog-section" . }}

<section id="custom" class="custom">
  <div class="custom__inner" data-reveal>
    <div>
      <div class="custom__eyebrow">Кастомное производство</div>
      <h2 class="custom__title">Нет нужного размера? <em>Сделаем.</em></h2>
      <p class="custom__text">Пришлите фото, размеры и список оборудования. Согласуем конструкцию, материалы и срок напрямую с производством.</p>
      <a class="btn btn--dark" href="{{ .Site.Telegram }}" target="_blank" rel="noopener noreferrer">Обсудить изделие ↗</a>
    </div>
    <ol class="steps">
      {{- range .Site.CustomSteps }}
      <li><span class="steps__num">{{ .Index }}</span><span class="steps__label">{{ .Title }}</span></li>
      {{- end }}
    </ol>
  </div>
</section>

<section id="about" class="section">
  <div class="features" data-reveal>
    {{- range .Site.Features }}
    <div>
      <div class="feature__index">{{ .Index }}</div>
      <h3 class="feature__title">{{ .Title }}</h3>
      <p class="feature__text">{{ .Text }}</p>
    </div>
    {{- end }}
  </div>
</section>

<section id="delivery" class="section section--flush-top">
  <div data-reveal>
    <div class="eyebrow">Получение заказа</div>
    <h2 class="section__title" style="margin-bottom: clamp(30px, 3.4vw, 56px)">Москва <span class="muted-head">и вся Россия</span></h2>
    <div class="delivery-grid">
      {{- range .Site.Delivery }}
      <div>
        <div class="delivery__num">{{ .Index }}</div>
        <h3 class="delivery__title">{{ .Title }}</h3>
        <p class="delivery__text">{{ .Text }}</p>
      </div>
      {{- end }}
    </div>
  </div>
</section>

{{ template "contacts" . }}
{{- end -}}
